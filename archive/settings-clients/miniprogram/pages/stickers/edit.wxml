<view class="page"><view class="page-head"><view class="title">编辑表情</view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card"><view class="body"><image wx:if="{{preview}}" class="image-large" mode="aspectFit" src="{{preview}}"/><view class="field"><text class="field-label">表情名称</text><input class="input" value="{{name}}" data-field="name" bindinput="input" maxlength="24" placeholder="取一个便于使用的名字"/></view><view class="field"><text class="field-label">使用状态</text><picker class="picker-field" range="{{statusNames}}" value="{{statusIndex}}" bindchange="status">{{statusNames[statusIndex]}}</picker></view><view class="field"><text class="field-label">画面描述</text><textarea class="textarea" value="{{description}}" data-field="description" bindinput="input" maxlength="200"/></view><view class="field"><text class="field-label">适用场景</text><input class="input" value="{{scenes}}" data-field="scenes" bindinput="input" maxlength="120"/></view><view class="hint">有名字且状态为“可用”时，bot 才会按语境发送。</view></view></view><view class="actions" style="margin-bottom:28rpx"><button class="danger" bindtap="remove" disabled="{{busy||!loaded}}">移出目录</button><button wx:if="{{admin}}" bindtap="publish" disabled="{{busy||!loaded}}">加入共享</button></view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy||!loaded}}">保存表情</button></view>
