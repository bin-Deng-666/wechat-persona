<view class="page"><view class="page-head"><view><view class="title">表情库 <text class="badge">{{images.length}}</text></view><view class="subtitle">点开图片，调整名字和使用场景。</view></view></view><picker wx:if="{{context.chats.length>1}}" class="contact" range="{{context.peerNames}}" value="{{context.peerIndex}}" bindchange="peer">当前聊天 · {{context.peerNames[context.peerIndex]}}　⌄</picker><view class="error" wx:if="{{error}}">{{error}}</view><view class="filters"><input class="search" value="{{query}}" bindinput="search" placeholder="搜索表情"/><picker class="filter-picker" range="{{statusNames}}" value="{{statusIndex}}" bindchange="status">{{statusNames[statusIndex]}}　⌄</picker></view><view class="grid"><view class="tile" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><image wx:if="{{item.preview}}" class="tile-image" mode="aspectFit" src="{{item.preview}}" lazy-load/><view wx:else class="tile-image muted" style="display:flex;align-items:center;justify-content:center;font-size:24rpx">点开查看</view><view class="tile-label"><text class="tile-name">{{item.name}}</text><text class="badge {{item.status==='ready'?'online':''}}">{{item.statusLabel}}</text></view></view></view><view class="card empty" wx:if="{{!visible.length}}"><view class="empty-title">{{images.length?'没有匹配的表情':'还没有表情'}}</view><view>{{images.length?'换个关键词或状态试试。':'在微信发张图片给 bot，它会出现在这里。'}}</view></view><view class="card"><view class="fold" bindtap="toggleShared"><text>共享表情 · {{shared.length}}</text><text>{{sharedOpen?'−':'+'}}</text></view><view wx:if="{{sharedOpen}}"><view class="row" wx:for="{{shared}}" wx:key="name"><text>{{item.name}}</text><text class="danger link" wx:if="{{context.access.admin}}" data-name="{{item.name}}" bindtap="unpublish">移除</text></view><view class="body hint" wx:if="{{!shared.length}}">暂无共享表情</view></view></view></view>
