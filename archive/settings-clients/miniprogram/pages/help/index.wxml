<view class="page"><view class="page-head"><view><view class="title">使用帮助</view><view class="subtitle">平时直接聊天，设置在这里调整。</view></view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card"><view class="body"><view class="label" style="margin-bottom:16rpx">微信快捷操作</view><view wx:for="{{commands}}" wx:key="name" style="padding:20rpx 0;border-bottom:1rpx solid #eeeef1"><text class="badge">{{item.usage}}</text><view class="hint" style="margin-top:12rpx">{{item.description}}</view></view></view></view><view class="card"><view wx:for="{{questions}}" wx:key="title"><view class="fold" data-index="{{index}}" bindtap="toggle"><text>{{item.title}}</text><text>{{item.open?'−':'+'}}</text></view><view class="fold-content muted" wx:if="{{item.open}}" style="font-size:26rpx">{{item.answer}}</view></view></view></view>
