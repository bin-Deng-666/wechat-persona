<view class="page"><view class="page-head"><view><view class="title">{{fresh?'新建人格':'编辑人格'}}</view><view class="subtitle">修改会影响使用这张卡的聊天。</view></view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card"><view class="body"><view class="field" wx:if="{{fresh}}"><text class="field-label">人格 ID</text><input class="input" value="{{id}}" data-field="id" bindinput="input" placeholder="例如 my-persona" maxlength="32"/></view><view class="field"><text class="field-label">显示名称</text><input class="input" value="{{name}}" data-field="name" bindinput="input"/></view><view class="field"><text class="field-label">一句话介绍</text><input class="input" value="{{description}}" data-field="description" bindinput="input"/></view><view class="field"><text class="field-label">身份与性格</text><textarea class="textarea large" value="{{identity}}" data-field="identity" bindinput="input" maxlength="6000"/></view><view class="field"><text class="field-label">说话方式（每行一条）</text><textarea class="textarea" value="{{style}}" data-field="style" bindinput="input" maxlength="3000"/></view><view class="field"><text class="field-label">行为规则（每行一条）</text><textarea class="textarea" value="{{rules}}" data-field="rules" bindinput="input" maxlength="3000"/></view><view class="row switch-row" style="padding:0"><text class="label">允许使用表情包</text><switch color="#242428" checked="{{sendStickers}}" bindchange="stickers"/></view></view><view class="fold" bindtap="toggleAdvanced"><text>高级 · 完整 JSON</text><text>{{advanced?'−':'+'}}</text></view><view class="fold-content" wx:if="{{advanced}}"><textarea class="textarea large" style="font-family:monospace;font-size:23rpx" value="{{raw}}" data-field="raw" bindinput="input" maxlength="50000"/></view></view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存人格</button></view>
