<view class="page"><view class="page-head"><view><view class="title">人格</view><view class="subtitle">选择喜欢的相处方式。</view></view><button class="primary small-button" bindtap="edit">＋ 新建</button></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card"><view class="row" wx:for="{{personas}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><view class="avatar">{{item.initial}}</view><view class="persona-copy"><view class="label">{{item.name}}</view><view class="hint">{{item.description}}</view></view><text class="arrow">›</text></view><view class="empty" wx:if="{{!personas.length}}">还没有人格，点击“新建”开始。</view></view></view>
