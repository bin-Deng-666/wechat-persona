<view class="page"><view class="page-head"><view><view class="title">聊天设置</view><view class="subtitle">调整喜欢的回复方式。</view></view><text class="badge {{context.access.botOnline?'online':'offline'}}">{{context.access.botOnline?'Bot 在线':'Bot 离线'}}</text></view><picker wx:if="{{context.chats.length>1}}" class="contact" range="{{context.peerNames}}" value="{{context.peerIndex}}" bindchange="peer">当前聊天 · {{context.peerNames[context.peerIndex]}}　⌄</picker><view class="error" wx:if="{{error}}">{{error}}</view><view class="card" wx:if="{{context.peer}}"><picker range="{{personaNames}}" value="{{personaIndex}}" bindchange="persona" disabled="{{saving}}"><view class="row"><text class="label">聊天人格</text><text class="value">{{personaNames[personaIndex]}}<text class="arrow">›</text></text></view></picker><view class="row switch-row"><view><view class="label">接收回复</view><view class="hint">关闭后暂停回复此聊天</view></view><switch color="#242428" checked="{{context.chat.enabled}}" disabled="{{saving}}" bindchange="enabled"/></view><view class="fold" bindtap="toggleMore"><text>更多回复设置</text><text class="muted">{{more?'−':'+'}}</text></view><view class="fold-content" wx:if="{{more}}"><view class="field"><text class="field-label">每条消息字数</text><input class="input" type="number" value="{{chars}}" bindinput="charsInput" bindblur="charsSave" bindconfirm="charsSave" placeholder="跟随人格"/></view><view class="field"><text class="field-label">长回答如何分条</text><picker range="{{splitNames}}" value="{{splitIndex}}" bindchange="split"><view class="picker-field">{{splitNames[splitIndex]}}</view></picker></view><text class="link" bindtap="resetStyle">恢复默认分条</text></view><view class="footer">{{saving?'正在保存…':'修改自动保存'}}</view></view><view class="card" wx:if="{{context.peer}}"><view class="body"><view class="label" style="margin-bottom:24rpx">对话操作</view><view class="actions"><button class="small-button" data-action="new" disabled="{{saving||!context.access.botOnline}}" bindtap="control">新对话</button><button class="small-button" data-action="compact" disabled="{{saving||!context.access.botOnline}}" bindtap="control">压缩</button><button class="small-button" data-action="stop" disabled="{{saving||!context.access.botOnline}}" bindtap="control">停止</button></view><view class="hint" wx:if="{{!context.access.botOnline}}" style="margin-top:20rpx">Bot 离线时仍可修改设置，上线后生效。</view></view></view><view class="empty" wx:if="{{context&&!context.peer}}">还没有聊天记录，先在微信向 bot 发一条消息。</view></view>
