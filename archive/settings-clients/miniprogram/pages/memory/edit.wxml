<view class="page"><view class="page-head"><view><view class="title">{{id?'编辑记忆':'新增记忆'}}</view><view class="subtitle">保存跨对话有用的信息。</view></view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card"><view class="body"><view class="field"><text class="field-label">标题</text><input class="input" value="{{title}}" data-field="title" bindinput="input" maxlength="160"/></view><view class="field"><text class="field-label">记忆内容</text><textarea class="textarea large" value="{{content}}" data-field="content" bindinput="input" maxlength="6000"/></view></view><view class="fold" data-key="more" bindtap="toggle"><text>类型与适用范围</text><text>{{more?'−':'+'}}</text></view><view class="fold-content" wx:if="{{more}}"><view class="field"><text class="field-label">类型</text><picker class="picker-field" range="{{types}}" value="{{typeIndex}}" bindchange="type">{{types[typeIndex]}}</picker></view><view class="field"><text class="field-label">确定性</text><picker class="picker-field" range="{{certainties}}" value="{{certaintyIndex}}" bindchange="certainty">{{certainties[certaintyIndex]}}</picker></view><view class="field"><text class="field-label">适用范围</text><input class="input" value="{{scope}}" data-field="scope" bindinput="input"/></view><view class="field"><text class="field-label">标签（顿号分隔）</text><input class="input" value="{{tags}}" data-field="tags" bindinput="input"/></view></view><view class="fold" data-key="sources" bindtap="toggle"><text>原话来源{{record?' · 版本 '+record.version:''}}</text><text>{{sources?'−':'+'}}</text></view><view class="fold-content" wx:if="{{sources}}"><view class="quote" wx:for="{{record.sources}}" wx:key="entryId">{{item.quote}}<view class="meta">{{item.timestamp}}</view></view><view class="hint" wx:if="{{!record.sources.length}}">人工输入，没有原话来源。</view></view></view><view class="save-bar"><button class="danger" wx:if="{{record}}" disabled="{{busy}}" bindtap="remove">删除</button><button class="primary" loading="{{busy}}" disabled="{{busy||(id&&!record)}}" bindtap="save">保存记忆</button></view></view>
