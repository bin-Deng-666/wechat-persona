<view class="page"><view class="page-head"><view><view class="title">个人记忆 <text class="badge">{{memories.length}}</text></view><view class="subtitle">重要的事，下次接着聊。</view></view><button class="primary small-button" bindtap="edit" disabled="{{!context.peer}}">＋ 新增</button></view><picker wx:if="{{context.chats.length>1}}" class="contact" range="{{context.peerNames}}" value="{{context.peerIndex}}" bindchange="peer">当前聊天 · {{context.peerNames[context.peerIndex]}}　⌄</picker><view class="error" wx:if="{{error}}">{{error}}</view><view class="filters"><input class="search" type="text" value="{{query}}" bindinput="search" placeholder="搜索记忆"/><picker class="filter-picker" range="{{types}}" value="{{typeIndex}}" bindchange="type">{{types[typeIndex]}}　⌄</picker></view><view class="card"><view class="memory-item" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><view class="item-title">{{item.title}}<text class="badge">{{item.type}}</text></view><view class="preview-text">{{item.content}}</view><view class="meta">{{item.scope||item.certainty}} · {{item.sources.length?'有原话来源':'人工输入'}}</view></view><view class="empty" wx:if="{{!visible.length}}"><view class="empty-title">{{memories.length?'没有匹配的记忆':'还没有记忆'}}</view><view>{{memories.length?'换个关键词试试。':'重要的偏好和经历，可以记在这里。'}}</view></view></view></view>
