<view class="page"><view class="page-head"><view><view class="title">登录设备</view><view class="subtitle">不再使用的设备，可以随时撤销。</view></view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card"><view class="row" wx:for="{{devices}}" wx:key="id"><view class="persona-copy"><view class="label">{{item.label}} <text class="badge" wx:if="{{item.current}}">当前设备</text></view><view class="hint">最近使用：{{item.time}}</view></view><button class="small-button danger" data-id="{{item.id}}" bindtap="revoke">{{item.current?'退出':'撤销'}}</button></view></view></view>
