page{background:#f7f7f8;color:#202024;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,input,textarea,button{box-sizing:border-box}button{margin:0;font-size:26rpx;font-weight:500;line-height:1.5;padding:20rpx 28rpx;border-radius:16rpx;background:#fff;color:#202024}button::after{border:1rpx solid #e7e7eb;border-radius:16rpx}button[disabled]{opacity:.45}button.primary{background:#242428;color:#fff}button.primary::after{border-color:#242428}.page{padding:32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom))}.title{font-size:44rpx;font-weight:650;letter-spacing:-1rpx}.subtitle{font-size:25rpx;color:#85858f;margin-top:6rpx}.page-head{display:flex;justify-content:space-between;align-items:center;gap:20rpx;margin-bottom:30rpx}.card{background:#fff;border:1rpx solid #e7e7eb;border-radius:26rpx;margin-bottom:28rpx;overflow:hidden}.body{padding:32rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:26rpx;padding:28rpx 32rpx}.row+.row{border-top:1rpx solid #eeeeF1}.label{font-size:28rpx;font-weight:500}.hint{font-size:23rpx;color:#85858f;margin-top:6rpx}.muted{color:#85858f}.value{font-size:27rpx;color:#61616b;max-width:360rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.arrow{color:#a1a1aa;margin-left:12rpx}.badge{font-size:22rpx;padding:4rpx 12rpx;background:#f1f1f3;border-radius:10rpx;color:#85858f}.online{color:#26834a;background:#eff9f2}.offline{color:#85858f;background:#eeeef1}.error{padding:20rpx 24rpx;margin-bottom:24rpx;border:1rpx solid #f0d3d3;border-radius:16rpx;background:#fff6f6;color:#b24141;font-size:25rpx}.empty{text-align:center;color:#85858f;padding:72rpx 30rpx}.empty-title{color:#3f3f46;font-size:29rpx;margin-bottom:10rpx}.field{margin-bottom:28rpx}.field-label{font-size:25rpx;font-weight:500;margin-bottom:12rpx;display:block}.input,.textarea,.picker-field{width:100%;padding:22rpx 24rpx;border:1rpx solid #dedee4;border-radius:16rpx;background:#fff;font-size:28rpx}.input{height:84rpx}.textarea{min-height:220rpx;height:260rpx;line-height:1.7}.textarea.large{height:360rpx}.fold{padding:26rpx 32rpx;border-top:1rpx solid #e7e7eb;display:flex;justify-content:space-between;font-size:26rpx}.fold-content{padding:0 32rpx 30rpx}.actions{display:flex;gap:16rpx}.actions button{flex:1}.danger{color:#c34242!important}.link{color:#61616b;font-size:25rpx}.search{background:#fff;border:1rpx solid #e1e1e6;border-radius:18rpx;padding:20rpx 24rpx;height:82rpx;flex:1;min-width:0;font-size:26rpx}.filters{display:flex;align-items:center;gap:16rpx;margin-bottom:26rpx}.filter-picker{padding:20rpx 22rpx;background:#fff;border:1rpx solid #e1e1e6;border-radius:18rpx;font-size:25rpx;white-space:nowrap}.memory-item{padding:30rpx 32rpx}.memory-item+.memory-item{border-top:1rpx solid #e7e7eb}.item-title{font-size:29rpx;font-weight:550;margin-bottom:10rpx;display:flex;align-items:center;gap:14rpx;flex-wrap:wrap}.preview-text{font-size:26rpx;color:#71717a;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-wrap}.meta{font-size:22rpx;color:#96969f;margin-top:12rpx}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx;margin-bottom:28rpx}.tile{background:#fff;border:1rpx solid #e7e7eb;border-radius:24rpx;overflow:hidden;min-width:0}.tile-image{width:100%;height:240rpx;background:#f0f0f3;padding:26rpx}.tile-label{padding:18rpx 20rpx;font-size:25rpx;display:flex;justify-content:space-between;align-items:center;gap:8rpx}.tile-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.image-large{width:100%;height:300rpx;background:#f0f0f3;border-radius:20rpx;margin-bottom:30rpx}.footer{padding:12rpx 0;color:#a1a1aa;text-align:center;font-size:22rpx}.quote{border-left:4rpx solid #e1e1e6;padding-left:20rpx;margin:22rpx 0;color:#71717a;font-size:25rpx}.contact{margin-bottom:26rpx;font-size:24rpx;color:#85858f}.save-bar{position:sticky;bottom:0;background:#f7f7f8;padding-top:20rpx;display:flex;gap:16rpx}.save-bar button{flex:1}.avatar{width:78rpx;height:78rpx;border-radius:22rpx;background:#f1f1f3;color:#61616b;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:550;flex:none}.persona-copy{flex:1;min-width:0}.small-button{font-size:24rpx;padding:14rpx 22rpx}.switch-row switch{transform:scale(.85);transform-origin:right center}
