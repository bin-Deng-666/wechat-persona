{
  "name": "dsh-wechat-persona",
  "version": "0.3.0-dev.0",
  "private": true,
  "type": "module",
  "description": "把微信单聊接入 DSH：基于腾讯 iLink 官方协议收发消息、复用宿主的模型与工具、人格卡与记忆、微信内中文设置菜单。",
  "license": "MIT",
  "author": "wechat-persona contributors",
  "homepage": "https://github.com/bin-Deng-666/wechat-persona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bin-Deng-666/wechat-persona.git"
  },
  "bugs": {
    "url": "https://github.com/bin-Deng-666/wechat-persona/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "weixin",
    "ilink",
    "chatbot",
    "persona",
    "llm-agent"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icons/dsh-wechat-persona.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "icons",
    "locale",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "clean": "rm -rf lib",
    "login": "node --experimental-strip-types scripts/login.ts",
    "evaluate:conversation": "node --experimental-strip-types scripts/evaluate-conversation.ts",
    "pack": "npm pack --pack-destination release"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.1",
    "@deepseek-ai/dsh-scope": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "pngjs": "^7.0.0",
    "qrcode-generator": "^2.0.4"
  },
  "icon": "icons/dsh-wechat-persona.svg"
}
